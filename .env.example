# PostgreSQL connection used by Next.js, Drizzle, migrations, and seed scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/caffe_ya

# Generate a unique secret with at least 32 characters for every deployment.
BETTER_AUTH_SECRET=replace-with-a-unique-secret-at-least-32-characters

# Public application origin. It must match the URL users open in the browser.
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated aliases in addition to the built-in RoastGrid Vercel origins.
BETTER_AUTH_TRUSTED_ORIGINS=

# Only enable for isolated demonstrations. Production must remain false.
DEMO_MODE=false
